From 490e58db3cc64ba78c0c1c08ac373af5f2fe5c01 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 16 Aug 2026 15:05:27 +0200
Subject: [PATCH] Fix dark theme surfaces and control contrast

---
 assets/css/theme-visibility.css | 238 ++++++++++++++++++++++++++++++++
 scripts/validate-responsive.js  |   4 +
 2 files changed, 242 insertions(+)

diff --git a/assets/css/theme-visibility.css b/assets/css/theme-visibility.css
index bc45a9f..b71f128 100644
--- a/assets/css/theme-visibility.css
+++ b/assets/css/theme-visibility.css
@@ -40,3 +40,241 @@ html[data-theme="dark"] :is(
 html[data-theme="dark"] .rd-first-response-list strong {
   color: #eef5fb !important;
 }
+
+/* Dark mode must replace the complete light clay layer. Changing only
+   background-color leaves the original pale gradients and white highlights
+   visible, which causes the washed-out panels and iridescent control edges. */
+html[data-theme="dark"] body.clay-ui {
+  --clay-canvas: #071421;
+  --clay-canvas-deep: #081827;
+  --clay-surface: #0d2033;
+  --clay-border: #35506b;
+  --clay-hi: transparent;
+  --clay-shadow: rgba(0, 0, 0, 0.32);
+  --clay-text: #eef5fb;
+  --clay-muted: #b7c7d7;
+  --clay-raised: 0 10px 24px rgba(0, 0, 0, 0.24);
+  --clay-small: 0 6px 16px rgba(0, 0, 0, 0.2);
+  --clay-inset: inset 0 1px 4px rgba(0, 0, 0, 0.48);
+  --rd-line: #35506b;
+  color: #eef5fb;
+}
+
+html[data-theme="dark"] body.clay-ui :is(h1, h2, h3, h4, h5, h6) {
+  color: #f5f9fc !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(p, li, dd, small, label) {
+  color: #b7c7d7 !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  .rd-text-action,
+  .rd-breadcrumb a,
+  .rd-card-link,
+  .rd-view-all-results,
+  .ss-detail-open-full,
+  .org-card-cta
+) {
+  color: #7eb8ff !important;
+}
+
+/* Replace every light gradient surface shown in the dashboard, wizard,
+   quality and organisations views with a true dark surface. */
+html[data-theme="dark"] body.clay-ui :is(
+  .card,
+  .catalog-item,
+  .result-card,
+  .symptom-group,
+  .assurance-meta,
+  .procedure-actions,
+  .wizard-results,
+  .wizard-section,
+  #wizard-root,
+  .rd-home-hero,
+  .rd-first-response,
+  .rd-onboarding-card,
+  .rd-domain-band,
+  .rd-domain-card,
+  .rd-trust-card,
+  .rd-list-total,
+  .rd-filter-panel,
+  .rd-article-meta-card,
+  .rd-toc-panel,
+  .rd-trust-legend,
+  .rd-tool-heading aside,
+  .rd-search-page-form,
+  .rd-search-help > div,
+  .rd-about-principles,
+  .rd-readiness-panel,
+  .rd-readiness-stat,
+  .org-home-section,
+  .org-home-card,
+  .org-hero-panel,
+  .org-service-card,
+  .org-process-band,
+  .org-process li,
+  .org-enquiry-form,
+  .org-enquiry-notes
+) {
+  background: #0d2033 !important;
+  border-color: #35506b !important;
+  color: #eef5fb !important;
+  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24) !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  .rd-domain-band,
+  .org-process-band,
+  .wizard-section
+) {
+  background: #091827 !important;
+  box-shadow: none !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  .rd-hero-trust-cue,
+  .rd-kpi-strip div,
+  .org-proof-strip span,
+  .ss-executive-summary > div
+) {
+  background: #132a3f !important;
+  border-color: #35506b !important;
+  color: #dce8f2 !important;
+  box-shadow: none !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  .rd-live-chip,
+  .org-service-icon
+) {
+  background: #10392f !important;
+  color: #a7f3d7 !important;
+  box-shadow: none !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  .rd-first-response-list li > span,
+  .org-process li > span,
+  .ss-detail-illustration
+) {
+  background: #173a59 !important;
+  color: #c7ddff !important;
+  box-shadow: none !important;
+}
+
+/* Remove pale clay highlights from form fields and search controls while
+   retaining a visible keyboard focus ring. */
+html[data-theme="dark"] body.clay-ui :is(
+  input,
+  select,
+  textarea,
+  .wizard-input,
+  [data-catalog-search],
+  [data-catalog-category]
+) {
+  background: #091a2a !important;
+  border-color: #4d6780 !important;
+  color: #eef5fb !important;
+  box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.48) !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  input,
+  select,
+  textarea,
+  .wizard-input,
+  [data-catalog-search],
+  [data-catalog-category]
+):focus {
+  background: #0b1f31 !important;
+  border-color: #6ca9ec !important;
+  box-shadow:
+    inset 0 1px 4px rgba(0, 0, 0, 0.48),
+    0 0 0 3px rgba(73, 145, 224, 0.24) !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(input, textarea)::placeholder {
+  color: #91a5ba !important;
+  opacity: 1;
+}
+
+/* Buttons remain elevated, but only with a neutral dark shadow. */
+html[data-theme="dark"] body.clay-ui :is(
+  .btn,
+  .btn-secondary,
+  .copy-command,
+  .run-diagnostic,
+  #wizard-root .wizard-count,
+  #wizard-root .wizard-submit,
+  .command-block
+) {
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28) !important;
+}
+
+html[data-theme="dark"] body.clay-ui .btn-secondary,
+html[data-theme="dark"] body.clay-ui #wizard-root .wizard-submit {
+  background: #17324a !important;
+  border-color: #46627e !important;
+  color: #eef5fb !important;
+}
+
+html[data-theme="dark"] body.clay-ui .btn-secondary:hover,
+html[data-theme="dark"] body.clay-ui #wizard-root .wizard-submit:hover {
+  background: #1d405e !important;
+  border-color: #6b8cac !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(
+  #wizard-root .symptom-group > summary,
+  #wizard-root .symptom-option,
+  #wizard-root .selected-chip
+) {
+  background: #132a3f !important;
+  border-color: #35506b !important;
+  color: #eef5fb !important;
+  box-shadow: none !important;
+}
+
+html[data-theme="dark"] body.clay-ui #wizard-root .symptom-option:hover,
+html[data-theme="dark"] body.clay-ui #wizard-root .symptom-option.is-selected,
+html[data-theme="dark"] body.clay-ui #wizard-root .symptom-option:has(input:checked) {
+  background: #173a59 !important;
+  border-color: #6ca9ec !important;
+  box-shadow: inset 3px 0 0 #6ca9ec !important;
+}
+
+html[data-theme="dark"] body.clay-ui :is(kbd, .rd-search-shortcut) {
+  background: #132a3f !important;
+  border-color: #4d6780 !important;
+  color: #eef5fb !important;
+  box-shadow: none !important;
+}
+
+/* The original clay rule targets every footer, including widget footers.
+   Keep embedded footers transparent and give only the site footer a panel. */
+html[data-theme="dark"] body.clay-ui footer {
+  background: transparent !important;
+  border-color: #35506b !important;
+  box-shadow: none !important;
+}
+
+html[data-theme="dark"] body.clay-ui footer.rd-footer {
+  background: #0b1f35 !important;
+}
+
+html[data-theme="dark"] body.clay-ui .rd-footer :is(
+  strong,
+  small,
+  p,
+  a,
+  span
+) {
+  color: #d6e3ee !important;
+}
+
+html[data-theme="dark"] body.clay-ui .ss-enterprise-trust-footer {
+  background: #081522 !important;
+  border-color: #35506b !important;
+  box-shadow: none !important;
+}
diff --git a/scripts/validate-responsive.js b/scripts/validate-responsive.js
index d42d84a..7b95ab0 100644
--- a/scripts/validate-responsive.js
+++ b/scripts/validate-responsive.js
@@ -52,6 +52,10 @@ requireText("assets/js/search.js", "aria-activedescendant", "accessible search r
 requireText("assets/css/theme-visibility.css", 'html[data-theme="light"] .site-brand-mark', "light-theme logo contrast correction is missing");
 requireText("assets/css/theme-visibility.css", ".rd-home-hero-copy h1", "dark-theme hero text contrast correction is missing");
 requireText("assets/css/theme-visibility.css", ".rd-first-response .rd-panel-heading h2", "dark-theme first-response heading contrast correction is missing");
+requireText("assets/css/theme-visibility.css", "--clay-raised: 0 10px 24px", "dark-theme clay highlights must be replaced with a neutral shadow");
+requireText("assets/css/theme-visibility.css", "#wizard-root", "dark-theme wizard surface correction is missing");
+requireText("assets/css/theme-visibility.css", ".org-enquiry-form", "dark-theme organisation form correction is missing");
+requireText("assets/css/theme-visibility.css", "body.clay-ui footer", "dark-theme embedded footer correction is missing");
 forbidText("assets/css/theme-visibility.css", "background-image", "theme visibility CSS must not replace the approved logo artwork");
 
 for (const file of ["assets/js/app.js", "assets/js/search.js"]) {
-- 
2.51.1

